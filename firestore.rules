/**
 * Core Philosophy: This ruleset enforces a strict multi-tenant security model where all data is partitioned by an organization ID (`orgId`). A user's access is strictly confined to the organization they belong to. No cross-organization data access is permitted.
 *
 * Data Structure: All application data is hierarchically organized under the top-level `orgs` collection. Each document within this structure (e.g., users, releases, outlet lists) contains a denormalized `orgId` field to enable efficient and secure authorization checks without costly lookups on parent documents.
 *
 * Key Security Decisions:
 * - Multi-Tenancy Firewall: The primary security boundary is the organization. All rules first verify that the authenticated user is a member of the organization associated with the data path.
 * - Role-Based Access: A three-tier role system ('Admin', 'User', 'Partner') is used. Admins have elevated privileges, Users manage content, and Partners can only submit content and view their own submissions.
 * - User Management: Only Admins can create or delete other users within their organization. Users can modify their own profile information.
 * - Org Provisioning: Creation and deletion of top-level organization documents are disallowed from the client, as these are assumed to be provisioned via a trusted server-side process.
 *
 * Denormalization for Authorization: To ensure performant and simple rules, every document contains an `orgId`. A user's role and organization membership are determined by a single `get` call to their own user document (`/orgs/{orgId}/users/{request.auth.uid}`). This avoids complex and slow multi-document reads during rule evaluation.
 *
 * Structural Segregation: Each data type (users, releases, etc.) is stored in its own dedicated subcollection under the parent organization. This clear separation ensures that security rules are specific and easy to manage for each data entity.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------

    /**
     * Checks if a user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Retrieves the authenticated user's profile document from within a specific organization.
     * This is the primary function for fetching the user's role and orgId for authorization checks.
     */
    function getUserData(orgId) {
      return get(/databases/$(database)/documents/orgs/$(orgId)/users/$(request.auth.uid));
    }

    /**
     * Verifies if the authenticated user is a member of the specified organization.
     * This is the foundational rule for multi-tenancy.
     */
    function isOrgMember(orgId) {
      return isSignedIn() && exists(/databases/$(database)/documents/orgs/$(orgId)/users/$(request.auth.uid));
    }

    /**
     * Verifies if the authenticated user is an Admin of the specified organization.
     */
    function isOrgAdmin(orgId) {
      return isOrgMember(orgId) && getUserData(orgId).data.role == 'Admin';
    }

    /**
     * Verifies if the authenticated user is a team member (Admin or User, not Partner).
     */
    function isTeamMember(orgId) {
      return isOrgMember(orgId) && (getUserData(orgId).data.role == 'Admin' || getUserData(orgId).data.role == 'User');
    }

    /**
     * Checks if the authenticated user's UID matches the provided userId.
     * Used for rules that grant access to a user's own data.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * On create, validates that the incoming document's orgId matches the orgId in the path.
     * Enforces data consistency for new documents.
     */
    function hasCorrectOrgIdOnCreate(orgId) {
      return request.resource.data.orgId == orgId;
    }

    /**
     * Verifies the authenticated user carries the platform superAdmin custom claim.
     * Mirrors requireSuperAdmin() in functions/src/super-admin.ts, media-network.ts and
     * credits.ts. Platform-level, not org-scoped — used for Smart Distribution's
     * Press Pilot-owned media network and credit ledger, which are structurally
     * off-limits to every org client regardless of role.
     */
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.superAdmin == true;
    }

    /**
     * On update, ensures the orgId of a document cannot be changed.
     * Prevents documents from being moved between organizations.
     */
    function isOrgIdImmutable() {
      return request.resource.data.orgId == resource.data.orgId;
    }

    /**
     * Billing / entitlement fields are written ONLY by Cloud Functions (Admin SDK
     * bypasses rules). Client updates must leave them unchanged — otherwise an org
     * admin could self-upgrade their tier/limits and bypass Stripe billing.
     */
    function billingFieldsUnchanged() {
      return request.resource.data.get('tier', null) == resource.data.get('tier', null)
        && request.resource.data.get('maxPartners', null) == resource.data.get('maxPartners', null)
        && request.resource.data.get('maxUsers', null) == resource.data.get('maxUsers', null);
    }

    /**
     * Federated-tenant structural fields are written ONLY by Cloud Functions
     * (provisionNewOrg, createChildOrg, the Admin SDK bypasses rules). An org's
     * own admin must not be able to re-parent themselves, edit their ancestor
     * chain, grant themselves child-org provisioning, or raise their own seat cap.
     */
    function federationFieldsUnchanged() {
      return request.resource.data.get('parentOrgId', null) == resource.data.get('parentOrgId', null)
        && request.resource.data.get('ancestorOrgIds', null) == resource.data.get('ancestorOrgIds', null)
        && request.resource.data.get('canProvisionChildOrgs', null) == resource.data.get('canProvisionChildOrgs', null)
        && request.resource.data.get('maxChildOrgs', null) == resource.data.get('maxChildOrgs', null)
        && request.resource.data.get('childOrgDefaultTier', null) == resource.data.get('childOrgDefaultTier', null);
    }


    /**
     * @description Rules for the top-level Organization documents.
     * @path /orgs/{orgId}
     * @allow (get) An authenticated member of the org reading their own organization's document.
     * @deny (create) Any user trying to create a new organization document from the client.
     * @principle Restricts modification of core organization data to Admins and disallows client-side creation/deletion.
     */
    match /orgs/{orgId} {
      // Public read of a single org doc (newsroom/release pages fetch by id == slug).
      // No public `list` — prevents enumerating all orgs and their plans.
      allow get: if true;
      allow list: if false;
      allow create: if false;
      allow update: if isOrgAdmin(orgId) && resource != null && billingFieldsUnchanged() && federationFieldsUnchanged();
      allow delete: if false;

      // Private billing state (Stripe ids, subscription status, trial, card-on-file).
      // Readable only by the org's own team; written only by Cloud Functions.
      match /billing/{docId} {
        allow read: if isTeamMember(orgId);
        allow write: if false;
      }
    }

    /**
     * @description Rules for User documents within an organization.
     * @path /orgs/{orgId}/users/{userId}
     * @allow (update) A user updating their own profile document.
     * @deny (delete) A non-admin user trying to delete another user's account in the same org.
     * @principle Enforces role-based access for user management; Admins manage all users, while individuals can manage their own profile.
     */
    match /orgs/{orgId}/users/{userId} {
      // Allow users to read their own document (needed for isOrgMember checks - breaks circular dependency)
      allow get: if isSignedIn() && request.auth.uid == userId;
      // Team members list all; partners MUST filter by their own partnerId
      allow list: if isTeamMember(orgId) || (isOrgMember(orgId) && resource.data.partnerId == request.auth.uid);
      allow create: if isOrgAdmin(orgId) && hasCorrectOrgIdOnCreate(orgId) && request.resource.data.id == userId;
      allow update: if (isOrgAdmin(orgId) || isOwner(userId)) && resource != null && isOrgIdImmutable() && request.resource.data.id == resource.data.id;
      allow delete: if isOrgAdmin(orgId) && resource != null;
    }

    /**
     * @description Rules for Press Release documents within an organization.
     * @path /orgs/{orgId}/releases/{releaseId}
     * @principle Team members only (Admin/User). Partners cannot access releases.
     */
    match /orgs/{orgId}/releases/{releaseId} {
      // Team members full access; public can read only Sent releases (newsroom)
      allow read: if isTeamMember(orgId) || resource.data.status == 'Sent';
      allow create: if isTeamMember(orgId) && hasCorrectOrgIdOnCreate(orgId);
      allow update: if isTeamMember(orgId) && resource != null && isOrgIdImmutable();
      allow delete: if isTeamMember(orgId) && resource != null;

      // Counter shards and daily stats — read-only for team, written by Cloud Functions
      match /counters/{shardId} {
        allow read: if isTeamMember(orgId);
        allow write: if false;
      }
      match /dailyStats/{dateId} {
        allow read: if isTeamMember(orgId);
        allow write: if false;
      }
    }
    /**
     * @description Rules for Outlet List documents within an organization.
     * @path /orgs/{orgId}/outletLists/{outletListId}
     * @principle Team members only. Partners cannot access outlet lists.
     */
    match /orgs/{orgId}/outletLists/{outletListId} {
      allow read: if isTeamMember(orgId);
      allow create: if isTeamMember(orgId) && hasCorrectOrgIdOnCreate(orgId);
      allow update: if isTeamMember(orgId) && resource != null && isOrgIdImmutable();
      allow delete: if isTeamMember(orgId) && resource != null;
    }

    /**
     * @description Rules for Recipient documents within an Outlet List.
     * @path /orgs/{orgId}/outletLists/{outletListId}/recipients/{recipientId}
     * @principle Team members only. Partners cannot access recipients.
     */
    match /orgs/{orgId}/outletLists/{outletListId}/recipients/{recipientId} {
      allow read: if isTeamMember(orgId);
      allow create: if isTeamMember(orgId) && hasCorrectOrgIdOnCreate(orgId) && request.resource.data.outletListId == outletListId;
      allow update: if isTeamMember(orgId) && resource != null && isOrgIdImmutable() && request.resource.data.outletListId == resource.data.outletListId;
      allow delete: if isTeamMember(orgId) && resource != null;
    }

    /**
     * @description Rules for saved CSV/XLSX import column-mapping profiles within an
     * organization. Lets a team re-apply the same spreadsheet-column mapping on future
     * imports instead of re-mapping every time.
     * @path /orgs/{orgId}/importMappingProfiles/{profileId}
     * @principle Team members only. Partners cannot access import mapping profiles.
     */
    match /orgs/{orgId}/importMappingProfiles/{profileId} {
      allow read: if isTeamMember(orgId);
      allow create: if isTeamMember(orgId) && hasCorrectOrgIdOnCreate(orgId);
      allow update: if isTeamMember(orgId) && resource != null && isOrgIdImmutable();
      allow delete: if isTeamMember(orgId) && resource != null;
    }

    /**
     * @description Press Pilot's own media network. Platform-owned, never tenant-scoped.
     * @path /mediaNetworkContacts/{contactId}
     * @principle Raw identity is a Press Pilot asset, not a customer asset. Only
     *            superadmins (the admin console) may read these documents directly.
     *            Org-facing clients never query this collection — matching and
     *            anonymised recommendations are produced by a Cloud Function and written
     *            to recommendationSnapshots instead. All writes happen via Cloud
     *            Functions using the Admin SDK, which bypasses these rules entirely — so
     *            `allow write: if false` here is a defence-in-depth backstop, not the
     *            primary control.
     */
    match /mediaNetworkContacts/{contactId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    /**
     * @description Upload history / review queue for Press Pilot media-network imports.
     * @path /mediaNetworkImportBatches/{batchId}
     * @principle Superadmin only. Written exclusively by importMediaNetworkBatch /
     *            publishMediaNetworkBatch Cloud Functions.
     */
    match /mediaNetworkImportBatches/{batchId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    /**
     * @description Anonymised recommendations actually shown to an organisation for a story.
     * @path /orgs/{orgId}/recommendationSnapshots/{snapshotId}
     * @principle Contains only anonymised labels, rationale, match band, credit cost and the
     *            customer's accept/reject decision — never a name or email for network-sourced
     *            entries. Written by Cloud Functions only, so the snapshot (and therefore the
     *            audit trail of what a customer was shown and chose) cannot be edited client-side.
     */
    match /orgs/{orgId}/recommendationSnapshots/{snapshotId} {
      allow get: if isTeamMember(orgId);
      allow list: if isTeamMember(orgId);
      allow write: if false;
    }

    /**
     * @description Press Pilot's own sales pipeline for Destination Briefs.
     * @path /mediaProspects/{prospectId}
     * @principle Superadmin-only READ — unlike /mediaSources, this is commercial data
     *            about organisations that are NOT customers, including internal notes and
     *            named contacts. No tenant may see it under any circumstances. All writes
     *            go through upsertMediaProspect.
     */
    match /mediaProspects/{prospectId} {
      allow read: if isSuperAdmin();
      allow write: if false;

      /**
       * @description Generated Destination Media Opportunity Briefs.
       * @path /mediaProspects/{prospectId}/briefs/{briefId}
       * @principle Superadmin-only. The stored `content` is a snapshot of what was printed
       *            and is never client-writable: a document whose evidence could be
       *            hand-edited would be worthless as a record. Regenerate instead.
       */
      match /briefs/{briefId} {
        allow read: if isSuperAdmin();
        allow write: if false;
      }
    }

    /**
     * @description Stored runs of the aggregate coverage benchmark (marketing statistics).
     * @path /coverageBenchmarks/{benchmarkId}
     * @principle Superadmin read, function-only write. Contains no organisation names and no
     *            prospect data by construction — it is outlet-level aggregate over the public
     *            item pool — but it is stored rather than recomputed so a figure that has been
     *            posted publicly can be reproduced later with the sample size behind it.
     */
    match /coverageBenchmarks/{benchmarkId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    /**
     * @description Tokenised public share links for Destination Briefs.
     * @path /briefShareLinks/{token}
     * @principle No client access at all, in either direction. A link holder reads the brief
     *            through the public getSharedBrief callable, which validates the token, checks
     *            the brief is still final, records the view and returns an allow-listed payload.
     *            Opening a read rule here instead would hand anyone holding a token the raw
     *            link document — prospect id, brief id, creator uid and viewer history — and
     *            let them enumerate the collection. Views are counted by the function with the
     *            Admin SDK, so `allow write: if false` also keeps the counters honest.
     */
    match /briefShareLinks/{token} {
      allow read, write: if false;
    }

    /**
     * @description Coverage records: one document per placement an org has earned.
     * @path /orgs/{orgId}/coverage/{coverageId}
     * @allow (read) Team members; and a Partner (member) named on the placement, so the partner
     *        portal can show "where your story appeared". Partners query with
     *        `partnerIds array-contains <uid>`, which this rule can prove against every result.
     * @allow (create, update, delete) Team members, in their own org, with the shape below.
     * @principle Logging coverage is ordinary editorial work, like editing a release, so it is a
     *            direct client write under validation rather than a callable. The shared,
     *            unauthenticated report reads these through getSharedCoverageReport with an
     *            allow-listed payload; nothing here is public. `notes` is therefore visible to
     *            featured members but never to report viewers, and the UI says so.
     */
    match /orgs/{orgId}/coverage/{coverageId} {
      function validCoverage() {
        let d = request.resource.data;
        return d.orgId == orgId
          && d.headline is string && d.headline.size() > 0 && d.headline.size() <= 300
          && d.outletName is string && d.outletName.size() > 0 && d.outletName.size() <= 200
          && d.url is string && d.url.size() <= 2000
          && d.publishedAtMs is number
          && d.mediaType in ['online', 'print', 'broadcast', 'podcast', 'social', 'newsletter', 'other']
          && d.outletType in ['local', 'regional', 'national', 'trade', 'international', 'other']
          && d.tone in ['positive', 'neutral', 'sensitive']
          && d.partnerIds is list && d.partnerIds.size() <= 50
          && d.partnerNames is list && d.partnerNames.size() <= 50
          && d.themes is list && d.themes.size() <= 10
          && d.fromPressPilotSend is bool;
      }
      allow read: if isTeamMember(orgId)
        || (isOrgMember(orgId) && request.auth.uid in resource.data.partnerIds);
      allow create: if isTeamMember(orgId) && validCoverage()
        && request.resource.data.createdById == request.auth.uid;
      allow update: if isTeamMember(orgId) && resource != null && validCoverage()
        && isOrgIdImmutable()
        && request.resource.data.createdById == resource.data.createdById;
      allow delete: if isTeamMember(orgId) && resource != null;
    }

    /**
     * @description Tokenised share links for coverage reports.
     * @path /coverageReportLinks/{token}
     * @principle Same as briefShareLinks: created, listed, revoked and opened only through
     *            callables in functions/src/coverage.ts, so the token collection is never
     *            enumerable and view counts cannot be forged.
     */
    match /coverageReportLinks/{token} {
      allow read, write: if false;
    }

    /**
     * @description Collection-group access for Destination Briefs.
     * @path /{path=**}/briefs/{briefId}
     * @principle Required because the admin console runs collectionGroup('briefs') to show
     *            the latest brief per prospect without one listener per row, and a nested
     *            `match /mediaProspects/{id}/briefs/{id}` does NOT authorise a
     *            collection-group query — Firestore evaluates those against rules whose
     *            path pattern matches at any depth. Same precedent as
     *            /{path=**}/recipients/{recipientId} below.
     *
     *            Grants nothing beyond the nested rule above: the condition is still
     *            isSuperAdmin(), and `briefs` exists nowhere else in the database. Read
     *            only, deliberately — Firestore unions all matching match blocks, so the
     *            nested rule remains the sole authority on writes and continues to deny
     *            every client write.
     */
    match /{path=**}/briefs/{briefId} {
      allow get, list: if isSuperAdmin();
    }

    /**
     * @description Press Pilot's curated Media Opportunities source registry.
     * @path /mediaSources/{sourceId}
     * @principle Platform-owned, superadmin-managed. Any signed-in user may READ, because
     *            an opportunity card names the sources behind it and the customer must be
     *            able to see which feeds Press Pilot monitors — that transparency is the
     *            product. Nothing here is confidential: every entry is a public feed URL.
     *            All writes go through upsertMediaSource / seedMediaSources / the ingestion
     *            scheduler using the Admin SDK, so `allow write: if false` is the backstop.
     */
    match /mediaSources/{sourceId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    /**
     * @description Normalised items collected from the monitored feeds.
     * @path /mediaItems/{itemId}
     * @principle Platform-level and shared — one article can be evidence for several
     *            organisations. Read-only for signed-in users (the evidence drawer on an
     *            opportunity card reads these); written only by ingestMediaSources.
     *            Stores source, headline, URL, date and the feed-supplied summary only,
     *            never full article text.
     */
    match /mediaItems/{itemId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    /**
     * @description An organisation's Media Opportunities watch configuration.
     * @path /orgs/{orgId}/mediaOpportunitySettings/{docId}
     * @principle Team members read; only updateMediaOpportunitySettings (Admin-gated)
     *            writes. Client writes are denied so `enabled` — which is what turns a
     *            paid add-on on — cannot be set from the browser.
     */
    match /orgs/{orgId}/mediaOpportunitySettings/{docId} {
      allow read: if isTeamMember(orgId);
      allow write: if false;
    }

    /**
     * @description Matched, evidence-backed opportunities shown to one organisation.
     * @path /orgs/{orgId}/mediaOpportunities/{opportunityId}
     * @principle Tenant-scoped: an organisation sees only its own matches, saves,
     *            dismissals and outcomes — never another customer's. Written exclusively
     *            by Cloud Functions (generateMediaOpportunities, setMediaOpportunityStatus,
     *            submitMediaOpportunityFeedback), so the record of what a customer was
     *            shown and what they decided is an audit trail, not editable UI state.
     */
    match /orgs/{orgId}/mediaOpportunities/{opportunityId} {
      allow get: if isTeamMember(orgId);
      allow list: if isTeamMember(orgId);
      allow write: if false;
    }

    /**
     * @description A customer's judgement on an opportunity card.
     * @path /orgs/{orgId}/mediaOpportunityFeedback/{feedbackId}
     * @principle Team members read their own org's feedback. Writes go through
     *            submitMediaOpportunityFeedback so every entry is attributable and the
     *            card's status change happens in the same trusted step.
     */
    match /orgs/{orgId}/mediaOpportunityFeedback/{feedbackId} {
      allow get: if isTeamMember(orgId);
      allow list: if isTeamMember(orgId);
      allow write: if false;
    }

    /**
     * @description Superadmin accountability trail for raw network-identity reads and
     *              credit-ledger mutations.
     * @path /auditLogs/{actorUid}/entries/{logId}
     * @principle Platform-level, not org-scoped. Superadmins may read only their OWN
     *            trail; written only by Cloud Functions (media-network.ts, credits.ts).
     *            QA fix (M11): this was previously a flat /auditLogs/{logId} collection
     *            with `allow read: if isSuperAdmin()`, which let ANY superadmin list/read
     *            EVERY superadmin's entries — contradicting this same comment's "read
     *            their own trail" intent, since a collection-level `list` rule has no
     *            resource.data to check per returned document. Nesting entries under the
     *            acting superadmin's uid lets the rule scope both `get` and `list` purely
     *            from the path, via the `actorUid` wildcard below.
     */
    match /auditLogs/{actorUid}/entries/{logId} {
      allow read: if isSuperAdmin() && request.auth.uid == actorUid;
      allow write: if false;
    }

    /**
     * @description Immutable per-organisation Smart Distribution credit ledger.
     * @path /orgs/{orgId}/creditTransactions/{transactionId}
     * @principle Every balance change (purchase, allowance, grant, usage, refund, expiry,
     *            reversal) is an individual, append-only record. Balance is derived from
     *            this ledger, never edited directly. Cloud Function / Admin SDK writes only.
     */
    match /orgs/{orgId}/creditTransactions/{transactionId} {
      allow get: if isTeamMember(orgId);
      allow list: if isTeamMember(orgId);
      allow write: if false;
    }

    /**
     * @description Cached current balance for an organisation's Smart Distribution wallet.
     * @path /orgs/{orgId}/creditWallet/{docId}
     * @principle A read-optimised cache derived from creditTransactions. Never the source
     *            of truth. Cloud Function / Admin SDK writes only.
     */
    match /orgs/{orgId}/creditWallet/{docId} {
      allow get: if isTeamMember(orgId);
      allow write: if false;
    }

    /**
     * @description QA fix (2026-08-20): internal credit HOLD for a network-contact
     *              send that is in flight between reservation and delivery outcome
     *              (see functions/src/credits.ts reserve/finalize/release). Purely an
     *              internal bookkeeping record — never rendered to any client, so it
     *              is not exposed for reads even to team members.
     * @path /orgs/{orgId}/creditReservations/{reservationId}
     * @principle Cloud Function / Admin SDK only. No client read or write.
     */
    match /orgs/{orgId}/creditReservations/{reservationId} {
      allow read, write: if false;
    }

    /**
     * @description QA fix (H1): server-private mapping from an opaque per-org
     *              reference ID to the real, stable mediaNetworkContacts document ID
     *              (see functions/src/network-contact-refs.ts). Client-readable docs
     *              (recommendationSnapshots, sendJobs/{id}/recipients) now store only
     *              the opaque reference here, never the real ID, so this collection
     *              must never be client-readable either — exposing it would defeat
     *              the whole point of the indirection.
     * @path /orgs/{orgId}/networkContactRefs/{refId}
     * @principle Cloud Function / Admin SDK only. No client read or write.
     */
    match /orgs/{orgId}/networkContactRefs/{refId} {
      allow read, write: if false;
    }

    /**
     * @description QA fix (H2): Rules for Send Job documents within an organization.
     *              Direct client create/update/delete is now denied — a sendJob is a
     *              billable, dispatch-triggering document (processSendJob's .onCreate
     *              trigger fires the moment one exists) and previously any team member
     *              could create/edit one directly with no validation of release
     *              approval state, outlet-list ownership, or confirmed Smart
     *              Distribution selection. The `createSendJob` callable
     *              (functions/src/index.ts) now performs all of that validation
     *              server-side and is the only supported way to create one;
     *              `cancelScheduledSend` (also a callable) is the only supported way
     *              to cancel one. Both use the Admin SDK, which bypasses these rules.
     * @path /orgs/{orgId}/sendJobs/{sendJobId}
     * @principle Team members only, read-only from the client.
     */
    match /orgs/{orgId}/sendJobs/{sendJobId} {
      allow read: if isTeamMember(orgId);
      allow create, update, delete: if false;
    }

    /**
     * @description Smart Distribution (Phase 4): per-recipient delivery + credit-cost
     * record for a send job. Extends the existing sendJobs collection (see
     * docs/smart-distribution/data-model-and-security.md §4). Team members may read
     * their own org's rows (to power the send-history/wallet UI) but never write —
     * only Cloud Functions create/update these (executeSendJob pre-creates each row;
     * the SendGrid webhook updates deliveryStatus and refund linkage). The
     * networkContactId field must never be exposed through client-facing reads of this
     * collection in application code (enforce in the callable/API layer, not just
     * here) — the read-time projection used in the UI is what actually keeps identity
     * hidden.
     * @path /orgs/{orgId}/sendJobs/{sendJobId}/recipients/{recipientId}
     * @principle Team members only, read-only from the client.
     */
    match /orgs/{orgId}/sendJobs/{sendJobId}/recipients/{recipientId} {
      allow get, list: if isTeamMember(orgId);
      allow write: if false;
    }

    /**
     * @description Collection-group counterpart of the two nested "recipients" rules
     * above (outletLists/{id}/recipients and sendJobs/{id}/recipients). The QA fix in
     * src/app/dashboard/outlets/[listId]/page.tsx runs `collectionGroup(firestore,
     * 'recipients')` filtered by orgId so the import wizard's duplicate check can see
     * every outlet list an org owns, not just the one open in the UI — that query
     * needs a matching wildcard rule or Firestore denies the whole `list` request with
     * "Missing or insufficient permissions", even though each nested collection
     * already grants the same team member the same read access individually.
     * Grants no access beyond what the two path-specific rules above already allow:
     * `resource.data.orgId` is the same immutable, server/rule-enforced field checked
     * there, so a caller can only ever see rows for orgs they already belong to.
     * @path /{path=**}/recipients/{recipientId}
     * @principle Team members only, read-only from the client. Grants read access only —
     *            no `write` rule here, deliberately: Firestore unions ALL matching
     *            `match` blocks for a given path, so the two path-specific rules above
     *            remain the sole authority on writes (outletLists/recipients still
     *            allows a team member's own-org create/update, sendJobs/recipients
     *            still denies every client write). Adding `allow write: if false` here
     *            would be a no-op for outletLists/recipients (a stricter rule elsewhere
     *            never revokes a grant from another matching rule) and would misleadingly
     *            suggest this block controls writes when it does not.
     */
    match /{path=**}/recipients/{recipientId} {
      allow get, list: if isTeamMember(resource.data.orgId);
    }

    /**
     * @description Rules for analytics Event documents within an organization.
     * @path /orgs/{orgId}/events/{eventId}
     * @principle Read-only for team members. Only Cloud Functions can write events.
     */
    match /orgs/{orgId}/events/{eventId} {
      allow read: if isTeamMember(orgId);
      allow create, update, delete: if false; // Only Cloud Functions can write events
    }

    /**
     * @description Rules for Partner Invite documents.
     * @path /orgs/{orgId}/invites/{inviteId}
     * @principle Only admins can manage invites.
     */
    /**
     * @description Partner email send records with open/click stats.
     * @path /orgs/{orgId}/partnerEmails/{emailId}
     * @principle Team members read. Cloud Functions write (no client creates).
     */
    match /orgs/{orgId}/partnerEmails/{emailId} {
      allow read: if isTeamMember(orgId);
      allow create, update, delete: if false;
    }

    /**
     * @description Individual tracking events for partner emails.
     * @path /orgs/{orgId}/partnerEmailEvents/{eventId}
     * @principle Team members read. Cloud Functions write only.
     */
    match /orgs/{orgId}/partnerEmailEvents/{eventId} {
      allow read: if isTeamMember(orgId);
      allow create, update, delete: if false;
    }

    match /orgs/{orgId}/invites/{inviteId} {
      allow read: if isOrgAdmin(orgId);
      allow create: if isOrgAdmin(orgId) && hasCorrectOrgIdOnCreate(orgId);
      allow update: if isOrgAdmin(orgId) && isOrgIdImmutable();
      allow delete: if isOrgAdmin(orgId);
    }

    /**
     * @description Rules for Tag documents.
     * @path /orgs/{orgId}/tags/{tagId}
     * @principle All org members (including partners) can read tags. Only admins can manage.
     */
    match /orgs/{orgId}/tags/{tagId} {
      allow read: if isOrgMember(orgId);
      allow create: if isOrgAdmin(orgId) && hasCorrectOrgIdOnCreate(orgId);
      allow update: if isOrgAdmin(orgId) && isOrgIdImmutable();
      allow delete: if isOrgAdmin(orgId);
    }

    /**
     * @description Rules for Media Request documents submitted by journalists.
     * @path /orgs/{orgId}/mediaRequests/{requestId}
     * @principle Public writes are handled exclusively by the submitStoryRequest Cloud Function.
     *            Team members can read and update status. No client-side create or delete.
     */
    match /orgs/{orgId}/mediaRequests/{requestId} {
      allow read: if isTeamMember(orgId);
      allow update: if isTeamMember(orgId) && resource != null && isOrgIdImmutable();
      allow create, delete: if false; // Cloud Function only
    }

    /**
     * @description Rules for Web Content documents generated from partner submissions.
     * @path /orgs/{orgId}/webContent/{contentId}
     * @principle Team members only (Admin/User). Partners cannot access web content.
     */
    match /orgs/{orgId}/webContent/{contentId} {
      allow read: if isTeamMember(orgId);
      allow create: if isTeamMember(orgId) && hasCorrectOrgIdOnCreate(orgId);
      allow update: if isTeamMember(orgId) && resource != null && isOrgIdImmutable();
      allow delete: if isTeamMember(orgId) && resource != null;
    }

    /**
     * @description Rules for Partner Submission documents.
     * @path /orgs/{orgId}/submissions/{submissionId}
     * @principle Team members can read all submissions. Partners can only read their own.
     *            Partners can create submissions (must set themselves as partnerId).
     *            Team members can update (status, notes). Only admins can delete.
     * @note Partner list queries are enforced by Firestore rules — the query MUST include where('partnerId', '==', uid).
     */
    /**
     * @description Platform-wide configuration (e.g. vertical category lists).
     * @path /platform/{docId}
     * @principle Any authenticated user can read (needed for partner signup + category filters).
     *            Writes are Cloud Function only — no client can write.
     */
    match /platform/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /orgs/{orgId}/submissions/{submissionId} {
      // Team members read all; partners can only read their own (enforced by client query filter)
      allow get: if isTeamMember(orgId) || (isOrgMember(orgId) && resource.data.partnerId == request.auth.uid);
      // Team members list all; partners MUST filter by their own partnerId
      allow list: if isTeamMember(orgId) || (isOrgMember(orgId) && resource.data.partnerId == request.auth.uid);
      allow create: if isOrgMember(orgId) &&
        hasCorrectOrgIdOnCreate(orgId) &&
        request.resource.data.partnerId == request.auth.uid;
      allow update: if isTeamMember(orgId) && resource != null && isOrgIdImmutable();
      allow delete: if isOrgAdmin(orgId) && resource != null;
    }
  }
}
